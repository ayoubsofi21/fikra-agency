{
  "name": "fikra-agency",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint --ext .js,.jsx .",
    "preview": "vite preview",
    "api:setup": "composer install --working-dir=backend && cd backend && cp -n .env.example .env && php artisan key:generate && touch database/database.sqlite && php artisan migrate --seed && php artisan storage:link",
    "api:serve": "php backend/artisan serve --host=127.0.0.1 --port=8000",
    "api:migrate": "php backend/artisan migrate --seed",
    "api:test": "php backend/artisan test",
    "api:queue": "php backend/artisan queue:work --tries=3"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.5.2",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^12.23.0",
    "i18next": "^25.6.3",
    "lucide-react": "^0.514.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.58.0",
    "react-i18next": "^15.4.3",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@tailwindcss/vite": "^4.1.3",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^6.4.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "playwright": "^1.65.0",
    "vite": "^8.3.7",
    "vite-plugin-compression": "^0.5.1"
  }
}
