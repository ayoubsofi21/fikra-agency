APP_NAME="FIKRA Agency"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin of the React + Vite frontend (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_SUPPORTED_LOCALES=en,fr,ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fikra_agency
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Private disk holds quote attachments (storage/app/private)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Private disk for quote-form uploads (never web-accessible)
QUOTE_ATTACHMENTS_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum personal access tokens (minutes, default 7 days)
SANCTUM_TOKEN_EXPIRATION=10080

# Version shown in the generated OpenAPI document (/docs)
API_VERSION=1.0.0

# Admin seeding: the first administrator is created from these values
ADMIN_NAME="FIKRA Admin"
ADMIN_EMAIL=admin@fikra.agency
ADMIN_PASSWORD=change-me-strong-password

# Notifications for new quote requests / solution requests / contact messages
TEAM_NOTIFICATION_EMAIL=team@fikra.agency

VITE_APP_NAME="${APP_NAME}"
