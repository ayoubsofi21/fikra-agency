# Fikra Agency - Environment Variables
# Copy this file to .env and adjust the values.

# API base URL (must include the version prefix).
# Development: /api/v1 is proxied to http://127.0.0.1:8000 by Vite.
# Production: point at the deployed API, e.g. https://api.fikra.agency/api/v1
VITE_API_URL=/api/v1

# Set to true to serve the bundled mock data with a simulated delay.
# Leave false to load content from the Laravel backend.
VITE_USE_MOCK=false
