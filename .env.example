# Fikra Agency - Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
# Set to your real backend endpoint (e.g. https://api.fikra.agency)
VITE_API_URL=

# Set to true to use mock data (default: true)
# Leave as true while developing; set to false when backend is ready
VITE_USE_MOCK=true
